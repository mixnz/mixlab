#!/usr/bin/env bash
# Three checks that are cheaper to fail here, before the commit exists, than in CI:
#
# - A change to what goes into the privileged helper must bump HELPER_VERSION. Run only when a
#   staged file is one the helper is built from (the list helper.lock keeps), or Cargo.lock.
# - The file size limit in docs/standards/source-files.md. Run only when a staged file is one the
#   check counts. It reads the working tree, not the index, so it can only be stricter than the
#   commit.
# - No roadmap task number in code (docs/standards/rust.md, *Comments*), on the same condition: a
#   commit that adds one learns it here, not from CI.
#
# Enabled once per clone with `git config core.hooksPath .githooks`. A commit that touches none of
# their files pays nothing for them.

set -euo pipefail

root="$(git rev-parse --show-toplevel)"
lock="$root/crates/mixengine-elevate/helper.lock"

staged="$(git diff --cached --name-only)"
[ -n "$staged" ] || exit 0

if [ -f "$lock" ]; then
  helper_files="$(node -e '
    const lock = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"));
    process.stdout.write(lock.files.join("\n"));
  ' "$lock")"

  concerns_the_helper=false
  if printf '%s\n' "$staged" | grep -qx 'Cargo.lock'; then
    concerns_the_helper=true
  elif printf '%s\n' "$staged" | grep -qxF -f <(printf '%s\n' "$helper_files"); then
    concerns_the_helper=true
  fi

  if [ "$concerns_the_helper" = true ]; then
    bash "$root/packaging/helper-lock.sh" --check
  fi
fi

# The same extensions scripts/check-file-sizes.mjs counts; its own exclusions apply inside it.
if printf '%s\n' "$staged" | grep -qE '\.(rs|ts|tsx|js|mjs|css)$'; then
  node "$root/scripts/check-file-sizes.mjs"
fi

# Those extensions again, and the build's configuration the citation check also reads.
if printf '%s\n' "$staged" | grep -qE '\.(rs|ts|tsx|js|mjs|css|toml)$|^\.github/'; then
  node "$root/scripts/check-task-citations.mjs"
fi
